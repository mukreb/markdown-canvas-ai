# Copy this file to .env and (optionally) fill in your key.

# Server-side Anthropic API key (https://console.anthropic.com/).
# OPTIONAL: without it, users bring their own key via the 🔑 button in the app
# (BYOK) — their key stays in their browser and is sent per request.
ANTHROPIC_API_KEY=

# Optional overrides
PORT=8787
# Model used for all AI operations. Defaults to the latest Opus.
ANTHROPIC_MODEL=claude-opus-4-8
